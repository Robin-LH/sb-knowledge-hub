{
  "name": "sitebeacon-knowledge-hub",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tinacms dev -c \"next dev --turbopack\"",
    "build": "if [ -z \"$TINA_TOKEN\" ]; then tinacms build --local; else tinacms build; fi && if [ \"$VERCEL_ENV\" = \"production\" ]; then rm -rf public/admin; fi && next build",
    "start": "tinacms build && next start",
    "format": "prettier . --write",
    "lint": "eslint --max-warnings=0 .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,html,css,json}": "prettier --write"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.13.0",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.13.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.2",
    "next-themes": "^0.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.3.0",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "only-allow": "^1.2.1",
    "postcss": "^8",
    "prettier": "3.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
